// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Competition {
  id          Int              @id @default(autoincrement())
  name        String
  startDate   DateTime
  endDate     DateTime
  venue       String
  rank        CompetitionRank?
  description String?

  organizerId Int
  organizer   User @relation("OrganizedCompetitions", fields: [organizerId], references: [id])

  status    CompetitionStatus    @default(DRAFT)
  setupStep CompetitionSetupStep @default(BASIC_INFO)

  settings CompetitionSettings?

  teams  Team[]
  rounds Round[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  CompetitionEntry CompetitionEntry[]
}

model CompetitionSettings {
  id            Int @id @default(autoincrement())
  competitionId Int @unique

  roundCount Int @default(1)

  assignmentMode AssignmentMode @default(DRAW)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id   Int    @id @default(autoincrement())
  name String

  competitionId Int
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  members TeamMember[]
}

model Competitor {
  id      Int    @id @default(autoincrement())
  name    String
  surname String

  teams   TeamMember[]
  entries CompetitionEntry[]
  starts  Start[]
}

model CompetitionEntry {
  id            Int @id @default(autoincrement())
  competitionId Int
  competitorId  Int

  category CompetitorCategory

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  competitor  Competitor  @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  starts Start[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, competitorId])
}

model TeamMember {
  id Int @id @default(autoincrement())

  competitorId Int
  teamId       Int

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, competitorId])
}

model Round {
  id     Int      @id @default(autoincrement())
  name   String
  number Int
  date   DateTime

  status RoundStatus @default(PLANNED)

  competitionId Int
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  sectors Sector[]
  starts  Start[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, number])
}

model Sector {
  id   Int    @id @default(autoincrement())
  name String

  category CompetitorCategory

  startPeg Int
  endPeg   Int
  capacity Int

  status SectorStatus @default(PLANNED)

  roundId Int
  round   Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  starts Start[]

  judges       SectorJudge[]
  judgeInvites JudgeInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundId, name])
}

model SectorJudge {
  id       Int @id @default(autoincrement())
  sectorId Int
  userId   Int

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sectorId, userId])
}

model JudgeInvite {
  id        Int      @id @default(autoincrement())
  sectorId  Int
  code      String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Start {
  id Int @id @default(autoincrement())

  competitionEntryId Int
  competitorId       Int
  roundId            Int
  sectorId           Int

  pegNumber Int

  weight        Int?
  penaltyPoints Int  @default(0)

  status StartStatus @default(PENDING)

  competitionEntry CompetitionEntry @relation(fields: [competitionEntryId], references: [id], onDelete: Cascade)
  competitor       Competitor       @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  round            Round            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  sector           Sector           @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  result Result?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitorId, roundId])
}

model Result {
  id Int @id @default(autoincrement())

  startId Int   @unique
  start   Start @relation(fields: [startId], references: [id], onDelete: Cascade)

  placeInSector Float?
  sectorPoints  Float?
  finalPoints   Float?

  status ResultStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(USER)

  competitions  Competition[] @relation("OrganizedCompetitions")
  judgedSectors SectorJudge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  ORGANIZER
  JUDGE
  USER
}

enum CompetitorCategory {
  SENIOR
  WOMAN
  U25
  U20
  U15
}

enum StartStatus {
  PENDING
  WEIGHED
  DNS
  DSQ
}

enum ResultStatus {
  PENDING
  CONFIRMED
}

enum CompetitionRank {
  FRIENDLY
  CLUB
  DISTRICT
  GPP
}

enum CompetitionStatus {
  DRAFT
  READY
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum CompetitionSetupStep {
  BASIC_INFO
  SETTINGS
  STRUCTURE
  PARTICIPANTS
  SUMMARY
  COMPLETED
}

enum AssignmentMode {
  DRAW
  MANUAL
}

enum RoundStatus {
  PLANNED
  DRAWN
  IN_PROGRESS
  FINISHED
}

enum SectorStatus {
  PLANNED
  DRAWN
  IN_PROGRESS
  READY_FOR_RESULTS
  FINISHED
}
